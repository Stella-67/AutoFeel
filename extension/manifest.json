{
  "manifest_version": 3,
  "name": "AI Form Helper",
  "version": "1.0.0",
  "description": "Alt+Click to AI-fill form fields",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/contentScript.js"],
      "run_at": "document_end"
    }
  ],
  "options_page": "options/options.html"
}